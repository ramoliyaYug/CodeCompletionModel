# ==========================================
# StarCoder2-3B Code Completion API Settings
# ==========================================

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*

# Base Model and Adapter Configuration
BASE_MODEL_NAME_OR_PATH=bigcode/starcoder2-3b
ADAPTER_DIR=../saved_models/starcoder2-3b-qlora-code-completion

# Model Inference Options
AUTO_LOAD_MODEL=true
USE_4BIT_QUANTIZATION=true
DEVICE=auto
MAX_CONTEXT_LENGTH=1024
DEFAULT_MAX_NEW_TOKENS=32
MAX_NEW_TOKENS_LIMIT=512
DEFAULT_TEMPERATURE=0.2
DEFAULT_TOP_P=0.95
DEFAULT_TOP_K=3
REPETITION_PENALTY=1.05

# Set to true for running tests or development without loading the 3B model
MOCK_INFERENCE=false
